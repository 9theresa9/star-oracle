{
  "name": "star-oracle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @star-oracle/api && npm run build -w @star-oracle/web",
    "typecheck": "npm run typecheck -w @star-oracle/api && npm run typecheck -w @star-oracle/web",
    "test": "node --test tests/engine.test.js tests/daily.test.js && npm run test -w @star-oracle/api",
    "dev:api": "npm run dev -w @star-oracle/api",
    "dev:web": "npm run dev -w @star-oracle/web",
    "db:migrate": "npm run db:migrate -w @star-oracle/api",
    "db:generate": "npm run db:generate -w @star-oracle/api",
    "admin:promote": "npm run admin:promote -w @star-oracle/api",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/node": "24.10.0"
  }
}
