# Private file: chmod 600 .env.ssh. The launcher accepts ONLY these keys.
# Generate six DIFFERENT values with: openssl rand -hex 32
# Database/cache/data-encryption keys are 64 hexadecimal characters.
# New AUTH_SECRET may also be 64 hex; an existing >=32-character secret MUST be preserved.
MYSQL_ROOT_PASSWORD=replace_with_independent_64_hex_characters
MYSQL_PASSWORD=replace_with_independent_64_hex_characters
MYSQL_MIGRATION_PASSWORD=replace_with_independent_64_hex_characters
REDIS_PASSWORD=replace_with_independent_64_hex_characters
AUTH_SECRET=replace_with_independent_64_hex_characters
# Existing secrets containing special characters can be represented as canonical
# UTF-8 base64. Use AUTH_SECRET_BASE64 instead of AUTH_SECRET, never both.
# AUTH_SECRET_BASE64=
DATA_ENCRYPTION_KEY=replace_with_independent_64_hex_characters
# Optional. Empty key uses the existing basic interpretations.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_NAME=DeepSeek
AI_MODEL=deepseek-chat
AI_DAILY_LIMIT=200
# Mode, origin, listen addresses, database hosts and proxy trust are fixed in
# compose.ssh.yml. The launcher rejects attempts to override them here.
