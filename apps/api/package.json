{
  "name": "@star-oracle/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:promote": "node dist/maintenance/promote-admin.js",
    "account:manage": "node dist/maintenance/account-cli.js"
  },
  "dependencies": {
    "@star-oracle/domain": "2.0.0",
    "@star-oracle/contracts": "2.0.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.0",
    "better-auth": "1.7.7",
    "@better-auth/redis-storage": "1.7.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "prisma": "6.19.0"
  },
  "devDependencies": {
    "@types/express": "5.0.5"
  }
}
