# Copy to .env.production. Generate independent secrets; never use example values.
DOMAIN=oracle.example.com
TLS_EMAIL=operator@example.com
MYSQL_ROOT_PASSWORD=replace_with_random_hex
MYSQL_PASSWORD=replace_with_random_hex
MYSQL_MIGRATION_PASSWORD=replace_with_at_least_48_random_hex_chars
REDIS_PASSWORD=replace_with_random_hex
AUTH_SECRET=replace_with_at_least_32_random_characters
DATA_ENCRYPTION_KEY=replace_with_64_hex_characters
ADMIN_REQUIRE_2FA=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_NAME=DeepSeek
AI_MODEL=deepseek-chat
AI_DAILY_LIMIT=200
# Optional; empty means basic interpretations only.
AI_API_KEY=
